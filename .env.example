# lars-pocket-app — environment template
# Copy to `.env` and fill in. Only PORT is required.
# Nothing here is secret for the beta (keys get rotated after testing).

# --- app ---
PORT=1122
ENV=dev

# --- brain switch: hermes (default) | cerebras ---
BRAIN=hermes

# --- Hermes leg (default). The app AUTO-DISCOVERS the gateway host/port + token
#     from the http://127.0.0.1:9119 page (see buildREADME §10) — no keys needed.
#     Only set HERMES_PROFILE (the Hermes profile to chat with). ---
HERMES_PROFILE=lars
# Optional override only if the gateway runs elsewhere:
# HERMES_WS_ORIGIN=http://127.0.0.1:9119

# --- Cerebras leg (only when BRAIN=cerebras) ---
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_URL=https://api.cerebras.ai/v1/chat/completions

# --- shared voice config (from pocket-tts) ---
POCKET_URL=http://localhost:1133/tts
POCKET_VOICE=af_heart
POCKET_CMD=uvx pocket-tts serve --port 1133
SYSTEM_PROMPT=Reply briefly.
HISTORY_TURNS=6
MAX_TOKENS=200
