# Copy to `.env` and fill in.
PORT=1122

# Hermes JSON-RPC/WS gateway (hermes serve) — profile chat target
HERMES_WS_URL=ws://127.0.0.1:8643/api/console
HERMES_PROFILE=lars
HERMES_API=http://127.0.0.1:8642

# Pocket TTS
POCKET_URL=http://localhost:1133/tts
POCKET_CMD=uvx pocket-tts serve --port 1133
