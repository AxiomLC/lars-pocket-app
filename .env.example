# lars-pocket-app — environment template
# Copy to `.env` and fill in. Port is the only required value.
# Nothing here is secret for the beta (keys get rotated after testing).

# --- app ---
PORT=1122
ENV=dev

# --- brain switch: hermes (default) | cerebras ---
BRAIN=hermes

# --- Hermes leg (default). Gateway on its natural port, no :8642 / :8643. ---
# HERMES_TOKEN must equal HERMES_DASHBOARD_SESSION_TOKEN that `hermes serve`
# was started with (loopback ?token= auth). Leave blank to skip / use ticket.
HERMES_WS_URL=ws://127.0.0.1:9119/api/ws
# Must match HERMES_DASHBOARD_SESSION_TOKEN the :9119 owner was started with.
# The Startup VBS Hermes_Dashboard.vbs sets it to: lars-voice-bridge-2026
HERMES_TOKEN=lars-voice-bridge-2026
HERMES_PROFILE=lars
# gated mode instead (uncomment if the gateway requires a ticket):
# HERMES_TICKET_URL=http://127.0.0.1:9119/api/auth/ws-ticket

# --- Cerebras leg (only used when BRAIN=cerebras) ---
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_URL=https://api.cerebras.ai/v1/chat/completions

# --- shared voice config (from pocket-tts) ---
POCKET_URL=http://localhost:1133/tts
POCKET_VOICE=af_heart
POCKET_CMD=uvx pocket-tts serve --port 1133
GROQ_MODEL=llama-3.1-8b-instant
SYSTEM_PROMPT=Reply briefly.
HISTORY_TURNS=6
MAX_TOKENS=200
